<?xml version="1.0" encoding="utf-8"?>
<!--
  Ascending bars, echoing the charts used throughout the app.
  Drawn as round-capped strokes so the caps form the rounded ends;
  each bar renders 5 units beyond its path on both ends.
  Everything sits inside the 72x72 adaptive-icon safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M39,64 L39,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,52 L54,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />

    <path
        android:pathData="M69,40 L69,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />
</vector>
